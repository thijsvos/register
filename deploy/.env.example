# Copy to `deploy/.env` and edit. Compose reads it automatically because it sits
# next to the compose file — you do not pass it, and a `.env` at the repository
# root does not override it.
#
#   cp deploy/.env.example deploy/.env
#   docker compose -f deploy/docker-compose.yml up -d

# Where your notes live. Required — compose refuses to start without it, rather
# than defaulting to a folder inside the checkout.
#
# An absolute path. `~` is not expanded here: compose is not a shell, and
# `~/vault` would be taken literally as a folder named `~`.
VAULT_PATH=/Users/you/vault

# Who the server writes as, on Linux only.
#
# Set these to your own ids (`id -u` and `id -g`) or every note the app creates
# is owned by uid 1000, which may be nobody or may be somebody else.
#
# On macOS and Windows they do nothing at all: Docker Desktop maps ownership to
# the calling user whatever the container says — measured, a file written by
# uid 1000 inside the container lands owned by you outside it. Leave them alone
# there.
#REGISTER_UID=1000
#REGISTER_GID=1000
