# Rust
/target/

# Node
node_modules/
app/dist/

# Dev vault (cargo run -- serve ./devvault). Unanchored on purpose: a second
# devvault/ anywhere in the tree makes that command mean different things from
# different directories, because cargo finds Cargo.toml by walking up while the
# path argument stays relative to where you are standing.
devvault/

# The compose default when VAULT_PATH is unset. Relative to the compose file, so
# `docker compose -f deploy/docker-compose.yml up` with no VAULT_PATH puts a real
# vault here — someone's actual notes, one `git add -A` from being committed.
deploy/vault/

# OS
.DS_Store

# cargo-mutants' scratch trees and report (ADR-006). Regenerated every run and
# large; the report that matters is the CI job summary and its artifact.
mutants.out/
