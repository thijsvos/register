{
  "name": "register-app",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": "^24"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "biome check --config-path=.. . && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "size": "size-limit"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.7",
    "@size-limit/file": "^13.0.3",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "size-limit": "^13.0.3",
    "svelte": "^5.56.8",
    "svelte-check": "^4.7.4",
    "typescript": "^6.0.3",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  },
  "size-limit": [
    {
      "name": "shell",
      "path": "dist/assets/shell-*.js",
      "limit": "60 kB",
      "gzip": true
    }
  ]
}
